{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/creator/:slug",
      "destination": "/index.html?creator=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/creator-portal.html",
      "permanent": false
    }
  ]
}
